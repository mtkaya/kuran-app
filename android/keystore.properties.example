# Bu dosyayi android/keystore.properties olarak kopyala ve doldur.
# keystore.properties .gitignore'da; depoya asla girmez.
#
# Play'in bekledigi sertifika:
#   CN=MEHMET TUGRUL KAYA, O=ARFHAUSE
#   SHA1 73:AB:94:6A:0B:D6:53:B9:BB:C7:1A:6D:7B:B8:18:E7:7E:69:B9:14
#
# Hangi keystore oldugunu dogrulamak icin:
#   keytool -list -v -keystore ~/keystore.jks | grep -A1 "SHA1:"

storeFile=/Users/tugrulkaya/keystore.jks
storePassword=
keyAlias=
keyPassword=
