{
    "providerId": "elmalili-meal-tr",
    "language": "tr",
    "name": "Elmalılı Hamdi Yazır Meali",
    "description": "Hak Dini Kur'an Dili - Elmalılı Muhammed Hamdi Yazır",
    "surahs": {
        "1": {
            "name": "Fatiha",
            "ayahs": {
                "1": "Bismillahirrahmanirrahim. Rahman, Rahim Allah'ın ismiyle.",
                "2": "Hamd, âlemlerin Rabbi Allah'a mahsustur.",
                "3": "O, Rahmân'dır, Rahîm'dir.",
                "4": "Din gününün malikidir.",
                "5": "Ancak Sana kulluk ederiz ve yalnız Senden yardım dileriz.",
                "6": "Bizi dosdoğru yola ilet.",
                "7": "Kendilerine nimet verdiklerinin yoluna; gazaba uğrayanların ve sapıkların yoluna değil."
            }
        },
        "112": {
            "name": "İhlas",
            "ayahs": {
                "1": "De ki: O, Allah'tır, bir tektir.",
                "2": "Allah Samed'dir. (Herşey O'na muhtaç, O hiçbir şeye muhtaç değil)",
                "3": "Doğurmamış ve doğmamıştır.",
                "4": "Hiçbir şey O'nun dengi olmamıştır."
            }
        },
        "113": {
            "name": "Felak",
            "ayahs": {
                "1": "De ki: Sabahın Rabbine sığınırım.",
                "2": "Yarattığı şeylerin şerrinden,",
                "3": "Karanlığı çöktüğü zaman gecenin şerrinden,",
                "4": "Düğümlere üfüren büyücülerin şerrinden,",
                "5": "Ve hased ettiği zaman hasetçinin şerrinden."
            }
        },
        "114": {
            "name": "Nas",
            "ayahs": {
                "1": "De ki: İnsanların Rabbine sığınırım.",
                "2": "İnsanların Melikine,",
                "3": "İnsanların İlahına,",
                "4": "O sinsi vesvesecinin şerrinden.",
                "5": "O ki, insanların göğüslerine vesvese verir.",
                "6": "Gerek cinlerden, gerek insanlardan."
            }
        }
    }
}